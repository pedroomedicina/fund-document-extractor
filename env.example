# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- LLM (OpenAI) ---
OPENAI_API_KEY=your_openai_api_key_here
# Chat model used for answers and extraction. Required: the server refuses to start without it.
# Pick a current model; the choice and its price are recorded in docs/decisions/.
LLM_MODEL=
# Monthly LLM spend the app will allow before refusing calls (enforced from Phase 2 on).
LLM_MONTHLY_BUDGET_USD=5

# --- Database (Postgres with pgvector, used from Phase 1 on) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fund_docs
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/fund_docs_test

# --- SEC EDGAR downloads (corpus fetch script) ---
# The SEC asks automated clients to identify themselves: "Name contact@example.com".
EDGAR_USER_AGENT=

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Uploads ---
# Set to false on the public demo: reviewers browse the preloaded corpus only.
ALLOW_UPLOADS=true
# 10 MB in bytes
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
