{
  "name": "rag-backend-service",
  "version": "0.2.0",
  "private": true,
  "description": "Fund Document Extractor: turns fund documents such as Limited Partnership Agreements into validated, typed data with every fact linked to its source page and passage. TypeScript, PostgreSQL + pgvector, Effect.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=json --outputFile=test-results.json && node scripts/assert-no-skipped.mjs test-results.json",
    "corpus:fetch": "tsx scripts/corpus-fetch.ts",
    "corpus:render": "tsx scripts/corpus-render.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.3.64",
    "@langchain/openai": "^0.6.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "effect": "^4.1.5",
    "express": "^5.1.0",
    "langchain": "^0.3.30",
    "multer": "^2.0.1",
    "openai": "^5.10.1",
    "pdf-parse": "^1.1.1",
    "unpdf": "^1.9.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "playwright": "^1.65.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
